          "v.s_z3 = v.snap ? 0 : (v.chg ? v.o_z3 - v.d_z3 : v.s_z3);",
          "v.ui = (v.chg && v.since < 0.15) ? v.ui * 0.5 + math.clamp(v.since, 0.03, 0.15) * 0.5 : v.ui;",
          "v.since = v.chg ? 0 : v.since;",
          "v.t = v.chg ? v.dt : v.t + v.dt;",
          "v.al = math.clamp(v.t / math.clamp(v.ui, 0.03, 0.15), 0, 1);",
          "v.hy = v.snap ? 0 : q.property('arachno:hop') * 4 * v.al * (1 - v.al);",
          "v.o_x0 = v.s_x0 * (1 - v.al);",
          "v.l_x0 = q.property('arachno:x0');",
          "v.o_y0 = v.s_y0 * (1 - v.al);",
          "v.l_y0 = q.property('arachno:y0');",
          "v.o_z0 = v.s_z0 * (1 - v.al);",
          "v.l_z0 = q.property('arachno:z0');",
          "v.o_x1 = v.s_x1 * (1 - v.al);",
          "v.l_x1 = q.property('arachno:x1');",
          "v.o_y1 = v.s_y1 * (1 - v.al);",
          "v.l_y1 = q.property('arachno:y1');",
          "v.o_z1 = v.s_z1 * (1 - v.al);",
          "v.l_z1 = q.property('arachno:z1');",
          "v.o_x2 = v.s_x2 * (1 - v.al);",
          "v.l_x2 = q.property('arachno:x2');",
          "v.o_y2 = v.s_y2 * (1 - v.al) + v.hy * 0.5;",
          "v.l_y2 = q.property('arachno:y2');",
          "v.o_z2 = v.s_z2 * (1 - v.al);",
          "v.l_z2 = q.property('arachno:z2');",
          "v.o_x3 = v.s_x3 * (1 - v.al);",
          "v.l_x3 = q.property('arachno:x3');",
          "v.o_y3 = v.s_y3 * (1 - v.al) + v.hy;",
          "v.l_y3 = q.property('arachno:y3');",
          "v.o_z3 = v.s_z3 * (1 - v.al);",
          "v.l_z3 = q.property('arachno:z3');",
          "v.gx = (q.property('arachno:x1') + v.o_x1) - (q.property('arachno:x0') + v.o_x0);",
          "v.gy = (q.property('arachno:y1') + v.o_y1) - (q.property('arachno:y0') + v.o_y0);",
          "v.gz = (q.property('arachno:z1') + v.o_z1) - (q.property('arachno:z0') + v.o_z0);",
          "v.gh = math.sqrt(v.gx * v.gx + v.gz * v.gz);",
          "v.gl = math.sqrt(v.gh * v.gh + v.gy * v.gy);",
          "v.o_a0 = (v.gl > 0.0001) ? math.atan2(v.gx, v.gz) - q.property('arachno:a0') : 0;",
          "v.o_a0 = v.o_a0 - 360 * math.round(v.o_a0 / 360);",
          "v.o_p0 = (v.gl > 0.0001) ? math.atan2(-v.gy, v.gh) - q.property('arachno:p0') : 0;",
          "v.o_l0 = (q.property('arachno:l0') > 0) ? v.gl - q.property('arachno:l0') : 0;",
          "v.gx = (q.property('arachno:x2') + v.o_x2) - (q.property('arachno:x1') + v.o_x1);",
          "v.gy = (q.property('arachno:y2') + v.o_y2) - (q.property('arachno:y1') + v.o_y1);",
          "v.gz = (q.property('arachno:z2') + v.o_z2) - (q.property('arachno:z1') + v.o_z1);",
          "v.gh = math.sqrt(v.gx * v.gx + v.gz * v.gz);",
          "v.gl = math.sqrt(v.gh * v.gh + v.gy * v.gy);",
          "v.o_a1 = (v.gl > 0.0001) ? math.atan2(v.gx, v.gz) - q.property('arachno:a1') : 0;",
          "v.o_a1 = v.o_a1 - 360 * math.round(v.o_a1 / 360);",
          "v.o_p1 = (v.gl > 0.0001) ? math.atan2(-v.gy, v.gh) - q.property('arachno:p1') : 0;",
          "v.o_l1 = (q.property('arachno:l1') > 0) ? v.gl - q.property('arachno:l1') : 0;",
          "v.gx = (q.property('arachno:x3') + v.o_x3) - (q.property('arachno:x2') + v.o_x2);",
          "v.gy = (q.property('arachno:y3') + v.o_y3) - (q.property('arachno:y2') + v.o_y2);",
          "v.gz = (q.property('arachno:z3') + v.o_z3) - (q.property('arachno:z2') + v.o_z2);",
          "v.gh = math.sqrt(v.gx * v.gx + v.gz * v.gz);",
          "v.gl = math.sqrt(v.gh * v.gh + v.gy * v.gy);",
          "v.o_a2 = (v.gl > 0.0001) ? math.atan2(v.gx, v.gz) - q.property('arachno:a2') : 0;",
          "v.o_a2 = v.o_a2 - 360 * math.round(v.o_a2 / 360);",
          "v.o_p2 = (v.gl > 0.0001) ? math.atan2(-v.gy, v.gh) - q.property('arachno:p2') : 0;",
          "v.o_l2 = (q.property('arachno:l2') > 0) ? v.gl - q.property('arachno:l2') : 0;",
          "v.ready = (q.property('arachno:t0') > 0) ? 1 : 0;"
        ],
        "animate": [ "pose" ]
      },
      "render_controllers": [ "controller.render.arachno_leg" ]
    }
  }
}
